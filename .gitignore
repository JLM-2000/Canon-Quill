# ---------------------------------------------------------------------------
# Canon Quill ignore rules
#
# The repo holds the engine only. Every byte of a book (references pulled from
# Drive, style corpora, bibles, drafts, chapters, exports) lives under
# workspaces/ and must never be committed. Confining generated content to one
# tree means a single rule covers anything added later.
# ---------------------------------------------------------------------------

# --- Generated book content (NEVER commit) ---------------------------------
workspaces/
.canon-quill/
.canon-quill-archives/

# Defence in depth: catch generated content even if it escapes the dirs above.
**/artifacts/
**/chapters/
**/manuscript.*
!src/analysis/manuscript.ts
!tests/manuscript.test.ts
**/style-corpus/
**/drive-cache/
*.docx
*.epub

# --- Secrets and credentials -----------------------------------------------
.env
.env.*
!.env.example
credentials.json
client_secret*.json
token.json
*token*.json
.auth/
*.pem
*.key
*.secret.*
*.local.*

# --- Build output and dependencies -----------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# --- Test and tooling output -----------------------------------------------
coverage/
.nyc_output/
.vitest/

# --- Logs and scratch ------------------------------------------------------
*.log
npm-debug.log*
tmp/
.tmp/

# --- OS / editor noise -----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
