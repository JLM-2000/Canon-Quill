{
  "name": "canon-quill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode agentic workflow for planning, drafting, reviewing, validating, and posting books from Google Drive references.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "check": "npm run build && npm run validate:workflow && npm test",
    "dev": "tsx src/cli.ts",
    "docx": "tsx src/cli.ts docx",
    "init:project": "tsx src/cli.ts init",
    "archive:project": "tsx src/cli.ts archive",
    "preview": "node dist/preview/server.js",
    "setup": "bash scripts/install.sh",
    "mcp:drive": "node dist/mcp/drive-server.js",
    "studio": "tsx src/studio/server.ts",
    "validate:workflow": "tsx src/cli.ts validate workflows/book-writing.workflow.yaml",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "docx": "^9.1.1",
    "express": "^4.19.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
